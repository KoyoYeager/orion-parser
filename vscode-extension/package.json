{
  "name": "orion-parser",
  "displayName": "OrionParser",
  "description": "Source code structure analysis & visualization — Call Tree, Flowchart, DFD, Class Diagram",
  "version": "0.1.0",
  "publisher": "KoyoYeager",
  "repository": {
    "type": "git",
    "url": "https://github.com/KoyoYeager/orion-parser.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onView:orionparser.actions"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "orionparser.analyzeFile",
        "title": "OrionParser: Analyze File",
        "icon": "$(search)"
      },
      {
        "command": "orionparser.showSymbols",
        "title": "OrionParser: Symbols"
      },
      {
        "command": "orionparser.showCallTree",
        "title": "OrionParser: Call Tree"
      },
      {
        "command": "orionparser.showFlowchart",
        "title": "OrionParser: Flowchart"
      },
      {
        "command": "orionparser.showDFD",
        "title": "OrionParser: DFD"
      },
      {
        "command": "orionparser.showClassDiagram",
        "title": "OrionParser: Class Diagram"
      },
      {
        "command": "orionparser.showTokens",
        "title": "OrionParser: Tokens"
      },
      {
        "command": "orionparser.showAST",
        "title": "OrionParser: AST"
      },
      {
        "command": "orionparser.analyzeFolder",
        "title": "OrionParser: Analyze Folder"
      },
      {
        "command": "orionparser.exportGraph",
        "title": "OrionParser: Export Graph"
      },
      {
        "command": "orionparser.action.selectFile",
        "title": "OrionParser: Open File...",
        "icon": "$(file-add)"
      },
      {
        "command": "orionparser.action.selectFolder",
        "title": "OrionParser: Open Folder...",
        "icon": "$(folder-opened)"
      },
      {
        "command": "orionparser.action.useActiveEditor",
        "title": "OrionParser: Use Active Editor",
        "icon": "$(file-code)"
      },
      {
        "command": "orionparser.action.runCallTree",
        "title": "OrionParser: Run Call Tree"
      },
      {
        "command": "orionparser.action.runFlowchart",
        "title": "OrionParser: Run Flowchart"
      },
      {
        "command": "orionparser.action.runDFD",
        "title": "OrionParser: Run DFD"
      },
      {
        "command": "orionparser.action.runClassDiagram",
        "title": "OrionParser: Run Class Diagram"
      },
      {
        "command": "orionparser.action.runSymbols",
        "title": "OrionParser: Run Symbols"
      },
      {
        "command": "orionparser.action.runTokens",
        "title": "OrionParser: Run Tokens"
      },
      {
        "command": "orionparser.action.runAST",
        "title": "OrionParser: Run AST"
      },
      {
        "command": "orionparser.action.currentTarget",
        "title": "OrionParser: Current Target"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orionparser",
          "title": "OrionParser",
          "icon": "$(symbol-structure)"
        }
      ]
    },
    "views": {
      "orionparser": [
        {
          "id": "orionparser.actions",
          "name": "Analysis"
        },
        {
          "id": "orionparser.symbols",
          "name": "Symbols"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "orionparser.action.selectFile",
          "when": "view == orionparser.actions",
          "group": "navigation@1"
        },
        {
          "command": "orionparser.action.selectFolder",
          "when": "view == orionparser.actions",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "orionparser.analyzeFile",
          "group": "orionparser@1",
          "when": "editorLangId == python"
        },
        {
          "command": "orionparser.showCallTree",
          "group": "orionparser@2",
          "when": "editorLangId == python"
        },
        {
          "command": "orionparser.showFlowchart",
          "group": "orionparser@3",
          "when": "editorLangId == python"
        },
        {
          "command": "orionparser.showClassDiagram",
          "group": "orionparser@4",
          "when": "editorLangId == python"
        }
      ],
      "editor/title": [
        {
          "command": "orionparser.analyzeFile",
          "group": "navigation",
          "when": "editorLangId == python"
        }
      ],
      "explorer/context": [
        {
          "command": "orionparser.analyzeFolder",
          "group": "orionparser",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "orionparser.analyzeFile",
          "group": "orionparser",
          "when": "resourceLangId == python"
        }
      ]
    },
    "keybindings": [
      {
        "command": "orionparser.analyzeFile",
        "key": "ctrl+shift+a",
        "when": "editorLangId == python"
      },
      {
        "command": "orionparser.showCallTree",
        "key": "ctrl+shift+t",
        "when": "editorLangId == python"
      },
      {
        "command": "orionparser.showFlowchart",
        "key": "ctrl+shift+f",
        "when": "editorLangId == python"
      }
    ],
    "configuration": {
      "title": "OrionParser",
      "properties": {
        "orionparser.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python interpreter"
        },
        "orionparser.orionParserPath": {
          "type": "string",
          "default": "",
          "description": "Path to orion-parser src directory (leave empty for auto-detect)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.7.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "glob": "^13.0.6"
  }
}
